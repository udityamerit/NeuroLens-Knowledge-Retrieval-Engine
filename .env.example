# Copy to .env and fill in. Never commit .env.  Nothing here is ever sent to the browser.

# ---- Core -------------------------------------------------------------------
NEUROLENS_ENV=development            # development | production
# Required in production (>= 32 chars):  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Encrypts per-organisation API keys at rest. Generate:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Default is SQLite in DATA_DIR. For Postgres: postgresql+psycopg://neurolens:PASSWORD@db:5432/neurolens
DATABASE_URL=
POSTGRES_PASSWORD=                   # only for `docker compose --profile postgres`

# ---- URLs / CORS ------------------------------------------------------------
FRONTEND_URL=http://localhost:5173   # where users land after SSO / invite links
PUBLIC_BASE_URL=http://localhost:8000  # public URL of the API (builds SSO redirect URIs)
CORS_ORIGINS=["http://localhost:5173"]
TRUSTED_HOSTS=["*"]                  # set to your real hostnames in production
TRUST_PROXY_HEADERS=false            # true only behind a reverse proxy you control

# ---- Platform LLM keys (optional; organisations can bring their own) --------
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
ALLOW_PLATFORM_KEYS=true

# ---- Single sign-on (leave blank to disable a provider) ---------------------
# Redirect URI to register with each provider:  <PUBLIC_BASE_URL>/api/auth/sso/<google|github|microsoft>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ---- Limits & guardrails ----------------------------------------------------
GUARDRAIL_MODE=block                 # block | flag | off
ORG_DAILY_QUERY_QUOTA=500
ORG_STORAGE_MB=500
MAX_UPLOAD_MB=25
RATE_LIMIT_PER_MINUTE=60
CHAT_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=10
